# Copia este archivo a .env para apuntar a tu propio proyecto de Supabase.
# Si se dejan vacías, la app usa las credenciales de respaldo de src/supabaseClient.js.
#
# IMPORTANTE: usa SIEMPRE la clave anon (publicable). Nunca la service_role:
# esa salta las políticas RLS y quedaría expuesta en el bundle del navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
